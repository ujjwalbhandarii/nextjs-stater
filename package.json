{
  "name": "vibe-ready-nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "format": "prettier --write .",
    "check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
